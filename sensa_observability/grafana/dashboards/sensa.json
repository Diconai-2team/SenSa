        "y": 32
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sensa_ai_forecast_duration_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p95 {{algorithm}}",
          "refId": "A"
