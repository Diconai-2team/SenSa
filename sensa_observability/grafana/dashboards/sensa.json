  "panels": [
    {
      "id": 1,
      "title": "Phase 1 — ARIMA Forecast 실행 시간 (95p / 50p)",
      "description": "AIForecastView 가 ARIMA(1,1,0) 또는 linear fallback 으로 N틱 예측을 계산하는 데 걸린 시간. 운영 실측 평균 14ms, p100 25ms 명세.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(sensa_ai_forecast_duration_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p95 {{algorithm}}",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.50, sum(rate(sensa_ai_forecast_duration_seconds_bucket[5m])) by (le, algorithm))",
          "legendFormat": "p50 {{algorithm}}",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Phase 5 — 60s Throttle 차단 누적 (운영자 알람 피로 감소 증거)",
      "description": "alarm_throttled_total — RE_ALARM_INTERVAL_SEC=60 정책으로 차단된 잠재 알람. sensor_type 별 분리. 큰 숫자일수록 운영자가 받지 않은 중복 알람이 많다는 뜻.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sensa_alarm_throttled_total",
          "legendFormat": "{{sensor_type}} ({{reason}})",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "title": "알람 생성 분당 속도 (Phase 1 + Phase 5)",
      "description": "rate(alarm_created_total[1m]) — sensor_type / alarm_level 별 분리. transition (상태 전이) 알람의 burst 가 시연 시점에 보임.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (sensor_type, alarm_level) (rate(sensa_alarm_created_total[1m]))",
          "legendFormat": "{{sensor_type}} / {{alarm_level}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "title": "GeoFence 활성 zone (정적 + 동적)",
      "description": "Gauge — 정적 zone 5 (관리자 그린 polygon) + 동적 zone (op_multi 시나리오 가동 시 +1). 실시간 매 scrape 시점 ORM 카운트.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sensa_zone_active_static",
          "legendFormat": "정적 zone",
          "refId": "A"
        },
        {
          "expr": "sensa_zone_active_dynamic",
          "legendFormat": "동적 zone",
          "refId": "B"
        },
        {
          "expr": "sensa_zone_active_static + sensa_zone_active_dynamic",
          "legendFormat": "전체",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "stepAfter": true
          }
        }
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "title": "FastAPI Generator publish 속도 (endpoint × result)",
      "description": "rate(publish_total[1m]) — sensor_data / worker_location / check_geofence 3 endpoint 별. result=ok 외에 http_error/exception 노출 시 인프라 이상.",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (endpoint, result) (rate(sensa_generator_publish_total[1m]))",
          "legendFormat": "{{endpoint}} / {{result}}",
          "refId": "A"
