{
  "uid": "sensa-gas",
  "title": "🧪 가스 농도 추세 (이상 상승 탐지)",
  "tags": [
    "sensa",
    "gas"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 200,
      "title": "CO 일산화탄소  (주의 25 / 위험 200 ppm)",
      "type": "timeseries",
      "datasource": {
        "type": "postgres",
        "uid": "sensa_pg"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ppm",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 25
              },
              {
                "color": "red",
                "value": 200
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "thresholdsStyle": {
              "mode": "line"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "postgres",
            "uid": "sensa_pg"
          },
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__timeGroupAlias(timestamp, $__interval), MAX(\"co\") AS \"최대(가장 위험)\", AVG(\"co\") AS \"평균\" FROM devices_sensordata WHERE $__timeFilter(timestamp) AND \"co\" IS NOT NULL GROUP BY 1 ORDER BY 1"
        }
      ]
    },
