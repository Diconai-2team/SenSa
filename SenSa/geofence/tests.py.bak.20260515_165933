from geofence.zone_lifecycle import (
    check_forecast_trigger,
    scan_forecast_warnings,
)
from geofence.anomaly_detector import get_forecast_warning


class ForecastTriggerTests(TestCase):
    """forecast_warn 기반 사전 경고 zone 자동 생성 검증.

    데이터 부족 (< 608) 환경에서도 안전하게 동작하는지 확인.
    TTM 실제 추론 결과 검증은 통합 검증 (Celery 자동 호출) 에서 확인.
    """

    def setUp(self):
        self.sensor = Device.objects.create(
            device_id='ft_sensor', device_name='FT',
            sensor_type='gas', x=300, y=300,
        )

    def test_insufficient_data_returns_safe(self):
        """608 건 미만 데이터 → warn=False, reason='insufficient_data'."""
        result = get_forecast_warning(self.sensor, 'co')
        self.assertFalse(result['warn'])
        self.assertEqual(result['reason'], 'insufficient_data')

    def test_check_forecast_trigger_no_data(self):
        """데이터 부족 시 zone 생성 안 됨."""
        outcome = check_forecast_trigger(self.sensor, 'co')
        self.assertEqual(outcome, 'insufficient_data')
        self.assertFalse(
            GeoFence.objects.filter(source_device=self.sensor, is_dynamic=True).exists()
        )

    def test_existing_zone_skipped(self):
        """이미 활성 zone 있으면 skip."""
        # 수동으로 zone 생성
        create_dynamic_zone(self.sensor, 'co', trigger_source='manual')

        outcome = check_forecast_trigger(self.sensor, 'co')
        self.assertEqual(outcome, 'existing')

        # zone 개수 변화 없음
        count = GeoFence.objects.filter(
            source_device=self.sensor, is_dynamic=True, is_active=True
        ).count()
        self.assertEqual(count, 1)

    def test_scan_collects_stats(self):
        """scan_forecast_warnings 가 통계 dict 반환."""
        result = scan_forecast_warnings(gas_types=['co'])
        self.assertIn('scanned', result)
        self.assertIn('zones_created', result)
        self.assertIn('insufficient', result)
        # 가스 센서 1개 × 'co' 1종 → scanned == 1
        self.assertGreaterEqual(result['scanned'], 1)


