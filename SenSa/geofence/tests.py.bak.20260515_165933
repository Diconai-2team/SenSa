class ZoneLifecycleTests(TestCase):

    def setUp(self):
        self.sensor = Device.objects.create(
            device_id='zlt_sensor', device_name='ZLT',
            sensor_type='gas', x=200, y=300,
        )

    def test_create_dynamic_zone_basic(self):
        z = create_dynamic_zone(self.sensor, 'co', 'manual')
        self.assertTrue(z.is_dynamic)
        self.assertEqual(z.tier, 'tentative')
        self.assertEqual(len(z.polygon), 16)

    def test_create_zone_has_expires_at(self):
        z = create_dynamic_zone(self.sensor, 'co')
        ttl = TIER_TTL_SECONDS['tentative']
        expected = timezone.now() + timedelta(seconds=ttl)
        delta = abs((z.expires_at - expected).total_seconds())
        self.assertLess(delta, 5)

    def test_initial_radius_matches_graham(self):
        z = create_dynamic_zone(self.sensor, 'co')
        expected = diffusion_radius('co', INITIAL_ELAPSED_SEC)
        self.assertAlmostEqual(z.current_radius_px, expected, places=2)

    def test_update_zone_radius_grows(self):
        z = create_dynamic_zone(self.sensor, 'co')
        initial = z.current_radius_px
        z.created_at = timezone.now() - timedelta(seconds=60)
        z.save()
        new_radius = update_zone_radius(z)
        self.assertGreater(new_radius, initial)

    def test_expire_zones(self):
        z1 = create_dynamic_zone(self.sensor, 'co')
        z2 = create_dynamic_zone(self.sensor, 'h2s')
        z2.expires_at = timezone.now() - timedelta(seconds=1)
        z2.save()
        self.assertEqual(expire_zones(), 1)
        z2.refresh_from_db()
        self.assertFalse(z2.is_active)
        z1.refresh_from_db()
        self.assertTrue(z1.is_active)

    def test_update_all_active_zones_only_dynamic(self):
        static_zone = GeoFence.objects.create(
            name='static', polygon=[[0, 0], [10, 0], [10, 10]],
            is_dynamic=False, is_active=True,
        )
        create_dynamic_zone(self.sensor, 'co')
        count = update_all_active_zones()
        self.assertEqual(count, 1)
        static_zone.refresh_from_db()
        self.assertEqual(static_zone.polygon, [[0, 0], [10, 0], [10, 10]])

    def test_tick_combines_all(self):
        z1 = create_dynamic_zone(self.sensor, 'co')
        z2 = create_dynamic_zone(self.sensor, 'h2s')
        z2.expires_at = timezone.now() - timedelta(seconds=1)
        z2.save()
        result = tick(check_upgrade=False)
        self.assertEqual(result['expired'], 1)
        self.assertEqual(result['updated'], 1)

    def test_polygon_has_16_points_for_single_center(self):
        z = create_dynamic_zone(self.sensor, 'co')
        self.assertEqual(len(z.polygon), 16)


