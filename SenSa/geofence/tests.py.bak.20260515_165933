"""
geofence 테스트 — Phase A, B, C 통합 (v2: timestamp 윈도우 분리).

- DiffusionTests (Phase A, 8개)
- PolygonUtilsTests (Phase C, 5개)
- ZoneLifecycleTests (Phase B, 8개)
- TierUpgradeTests (Phase C, 6개)

[v2 수정]
TierUpgradeTests._inject_anomaly 의 timestamp 가 LOOKBACK_RECENT_SEC=300 의
경계와 너무 가까워 분류가 흔들리는 문제 해결.
baseline 데이터를 500~1500초 전으로 확실히 분리.

usage:
    python manage.py test geofence
"""
from datetime import timedelta
from django.test import SimpleTestCase, TestCase
from django.utils import timezone

from devices.models import Device, SensorData
from geofence.models import GeoFence
from geofence.diffusion import (
    relative_velocity, diffusion_radius, gas_reach_time, R_MAX,
)
from geofence.polygon_utils import (
    circle_polygon, hull_with_margin, build_zone_polygon, _convex_hull,
)
from geofence.zone_lifecycle import (
    create_dynamic_zone,
    update_zone_radius,
    update_all_active_zones,
    expire_zones,
    check_tier_upgrade,
    tick,
    TIER_TTL_SECONDS,
    INITIAL_ELAPSED_SEC,
)
from geofence.anomaly_detector import get_recent_residual, has_anomaly


# ────────────────────────────────────────
# Phase A
# ────────────────────────────────────────

class DiffusionTests(SimpleTestCase):
    def test_nh3_faster_than_so2(self):
        self.assertGreater(relative_velocity('nh3'), relative_velocity('so2'))

    def test_co_close_to_air(self):
        self.assertAlmostEqual(relative_velocity('co'), 1.0, places=1)

    def test_unknown_gas_defaults_to_air(self):
        self.assertEqual(relative_velocity('unknown'), 1.0)

    def test_radius_grows_with_time(self):
        self.assertLess(diffusion_radius('co', 30), diffusion_radius('co', 60))

    def test_radius_capped_at_r_max(self):
        self.assertEqual(diffusion_radius('nh3', 10000), R_MAX)

    def test_radius_zero_at_t0(self):
        self.assertEqual(diffusion_radius('co', 0), 0)

    def test_negative_time_treated_as_zero(self):
        self.assertEqual(diffusion_radius('co', -10), 0)

    def test_reach_time_inverse_of_radius(self):
        target = 100.0
        t = gas_reach_time('co', target)
        self.assertAlmostEqual(diffusion_radius('co', t), target, places=2)


