class PolygonUtilsTests(SimpleTestCase):

    def test_circle_polygon_point_count(self):
        pts = circle_polygon(0, 0, 50, n_points=16)
        self.assertEqual(len(pts), 16)

    def test_convex_hull_single_point(self):
        self.assertEqual(_convex_hull([(0, 0)]), [(0, 0)])

    def test_convex_hull_square(self):
        pts = [(0, 0), (10, 0), (10, 10), (0, 10), (5, 5)]
        hull = _convex_hull(pts)
        self.assertEqual(len(hull), 4)
        self.assertNotIn((5, 5), hull)

    def test_hull_with_margin_single_center(self):
        poly = hull_with_margin([(50, 50)], margin_radius=10)
        self.assertGreaterEqual(len(poly), 3)

    def test_build_zone_polygon_branches(self):
        p1 = build_zone_polygon([(0, 0)], radius=20)
        self.assertEqual(len(p1), 16)
        p2 = build_zone_polygon([(0, 0), (100, 0)], radius=20)
        self.assertGreaterEqual(len(p2), 3)
        p3 = build_zone_polygon([(0, 0), (100, 0), (50, 100)], radius=20)
        self.assertGreaterEqual(len(p3), 3)


