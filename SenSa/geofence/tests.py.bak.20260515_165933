from geofence.models import ZoneEvent
from datetime import timedelta as _td


class ZoneEventTests(TestCase):
    """zone 생성·승격·만료 시 ZoneEvent 자동 기록 검증."""

    def setUp(self):
        self.s1 = Device.objects.create(
            device_id='ze_s1', device_name='ZE1',
            sensor_type='gas', x=100, y=100,
        )
        self.s2 = Device.objects.create(
            device_id='ze_s2', device_name='ZE2',
            sensor_type='gas', x=130, y=100,
        )
        self.s3 = Device.objects.create(
            device_id='ze_s3', device_name='ZE3',
            sensor_type='gas', x=160, y=100,
        )
        self.s4 = Device.objects.create(
            device_id='ze_s4', device_name='ZE4',
            sensor_type='gas', x=190, y=100,
        )
        from devices.neighbor_graph import invalidate_neighbor_cache
        invalidate_neighbor_cache()

    def _inject_anomaly(self, device, gas, recent_val, baseline_val):
        now = timezone.now()
        for i in range(5):
            sd = SensorData.objects.create(device=device, **{gas: baseline_val})
            SensorData.objects.filter(pk=sd.pk).update(
                timestamp=now - _td(seconds=500 + i * 200),
            )
        sd = SensorData.objects.create(device=device, **{gas: recent_val})
        SensorData.objects.filter(pk=sd.pk).update(
            timestamp=now - _td(seconds=5),
        )

    def test_create_emits_event(self):
        """create_dynamic_zone → 'created' 이벤트 1건."""
        zone = create_dynamic_zone(self.s1, 'co', trigger_source='ttm_anomaly')
        events = ZoneEvent.objects.filter(zone=zone)
        self.assertEqual(events.count(), 1)
        self.assertEqual(events.first().event_type, 'created')
        self.assertEqual(events.first().to_tier, 'tentative')
        self.assertEqual(events.first().trigger_source, 'ttm_anomaly')

    def test_upgrade_emits_event(self):
        """tentative → confirmed 승격 시 'upgraded_to_confirmed' 이벤트."""
        zone = create_dynamic_zone(self.s1, 'co')
        zone.current_radius_px = 200
        zone.save()

        self._inject_anomaly(self.s2, 'co', recent_val=50, baseline_val=10)
        check_tier_upgrade(zone)

        events = ZoneEvent.objects.filter(zone=zone).order_by('created_at')
        types = [e.event_type for e in events]
        # 'created' 발생 후 'upgraded_to_confirmed'
        self.assertIn('upgraded_to_confirmed', types)

        upgrade_event = events.filter(event_type='upgraded_to_confirmed').first()
        self.assertEqual(upgrade_event.from_tier, 'tentative')
        self.assertEqual(upgrade_event.to_tier, 'confirmed')

    def test_expire_emits_event(self):
        """만료 시 'expired' 이벤트."""
        zone = create_dynamic_zone(self.s1, 'co')
        zone.expires_at = timezone.now() - _td(seconds=1)
        zone.save()

        expire_zones()

        events = ZoneEvent.objects.filter(zone=zone, event_type='expired')
        self.assertEqual(events.count(), 1)

    def test_critical_upgrade_emits_event(self):
        """3개 확인 시 critical 승격 + 이벤트."""
        zone = create_dynamic_zone(self.s1, 'co')
        zone.current_radius_px = 200
        zone.save()

        for s in [self.s2, self.s3, self.s4]:
            self._inject_anomaly(s, 'co', recent_val=50, baseline_val=10)
        check_tier_upgrade(zone)

        events = ZoneEvent.objects.filter(
            zone=zone, event_type='upgraded_to_critical'
        )
        self.assertEqual(events.count(), 1)
        self.assertEqual(events.first().to_tier, 'critical')
