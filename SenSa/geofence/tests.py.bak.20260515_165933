class TierUpgradeTests(TestCase):

    def setUp(self):
        self.s1 = Device.objects.create(
            device_id='tut_s1', device_name='S1',
            sensor_type='gas', x=100, y=100,
        )
        self.s2 = Device.objects.create(
            device_id='tut_s2', device_name='S2',
            sensor_type='gas', x=130, y=100,
        )
        self.s3 = Device.objects.create(
            device_id='tut_s3', device_name='S3',
            sensor_type='gas', x=160, y=100,
        )
        self.s4 = Device.objects.create(
            device_id='tut_s4', device_name='S4',
            sensor_type='gas', x=190, y=100,
        )

        from devices.neighbor_graph import invalidate_neighbor_cache
        invalidate_neighbor_cache()

    def _inject_anomaly(self, device, gas, recent_val, baseline_val):
        """v2: 윈도우 경계와 분리된 timestamp 사용.

        LOOKBACK_RECENT_SEC=300 / LOOKBACK_BASELINE_SEC=1800 가정.
        - baseline: 500~1500초 전 (확실히 baseline 윈도우 안)
        - recent:   5초 전        (확실히 recent 윈도우 안)
        """
        now = timezone.now()

        # baseline 5건 — 500, 700, 900, 1100, 1300초 전
        for i in range(5):
            sd = SensorData.objects.create(
                device=device, **{gas: baseline_val},
            )
            SensorData.objects.filter(pk=sd.pk).update(
                timestamp=now - timedelta(seconds=500 + i * 200),
            )

        # recent 1건 — 5초 전
        sd = SensorData.objects.create(
            device=device, **{gas: recent_val},
        )
        SensorData.objects.filter(pk=sd.pk).update(
            timestamp=now - timedelta(seconds=5),
        )

    def test_residual_basic(self):
        """잔차 계산 정확성 (recent - baseline)."""
        self._inject_anomaly(self.s1, 'co', recent_val=50, baseline_val=10)
        r = get_recent_residual(self.s1, 'co')
        self.assertGreater(r, 15)

    def test_has_anomaly_above_threshold(self):
        """잔차 임계 초과 시 has_anomaly=True."""
        self._inject_anomaly(self.s2, 'co', recent_val=50, baseline_val=10)
        self.assertTrue(has_anomaly(self.s2, 'co'))

    def test_no_anomaly_when_stable(self):
        """잔차 작으면 has_anomaly=False."""
        self._inject_anomaly(self.s3, 'co', recent_val=11, baseline_val=10)
        self.assertFalse(has_anomaly(self.s3, 'co'))

    def test_no_upgrade_when_no_anomaly(self):
        zone = create_dynamic_zone(self.s1, 'co')
        zone.current_radius_px = 200
        zone.save()
        outcome = check_tier_upgrade(zone)
        self.assertEqual(outcome, 'unchanged')

    def test_upgrade_tentative_to_confirmed(self):
        zone = create_dynamic_zone(self.s1, 'co')
        zone.current_radius_px = 200
        zone.save()

        self._inject_anomaly(self.s2, 'co', recent_val=50, baseline_val=10)

        outcome = check_tier_upgrade(zone)
        zone.refresh_from_db()
        self.assertEqual(outcome, 'upgraded_to_confirmed')
        self.assertEqual(zone.tier, 'confirmed')
        self.assertIn(self.s2, list(zone.confirmed_devices.all()))

    def test_upgrade_to_critical_with_3_confirmations(self):
        zone = create_dynamic_zone(self.s1, 'co')
        zone.current_radius_px = 200
        zone.save()

        for s in [self.s2, self.s3, self.s4]:
            self._inject_anomaly(s, 'co', recent_val=50, baseline_val=10)

        outcome = check_tier_upgrade(zone)
        zone.refresh_from_db()
        self.assertEqual(outcome, 'upgraded_to_critical')
        self.assertEqual(zone.tier, 'critical')
        self.assertEqual(zone.confirmed_devices.count(), 3)


