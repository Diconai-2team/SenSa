"""
geofence/anomaly_detector.py — 센서 이상 신호 판정.

[v3 — TTM 직접 통합]
이전 v2 (SensorData 평균 차이 placeholder) 에서 TTM zero-shot 추론으로 교체.
같은 Django 프로세스 안에서 TTM 호출 — HTTP overhead 없음, 첫 호출 시 lazy load.

[Fallback 전략]
TTM 입력 최소 길이 (608 step) 미만이면 v2 의 단순 평균 차이로 fallback.
운영 초기 데이터 부족 시에도 동작 보장.

[인터페이스 무수정]
get_recent_residual(device, gas_type) → float
has_anomaly(device, gas_type, threshold=None) → bool
호출 측 (zone_lifecycle.check_tier_upgrade) 코드 변경 불필요.
"""
from datetime import timedelta
from django.db.models import Avg
from django.utils import timezone

from geofence.ai.ttm_engine import (
    engine,
    MIN_INPUT_LENGTH,
    DOMAIN_THRESHOLDS,
    DEFAULT_THRESH,
)


# ── Fallback (TTM 입력 부족 시 v2 동작) 윈도우 ──
LOOKBACK_RECENT_SEC = 300       # 최근 5분
LOOKBACK_BASELINE_SEC = 1800    # 직전 30분

# ── has_anomaly 임계 (도메인별, ttm_engine 의 RESIDUAL_ABS_LIMIT 와 동일) ──
CONFIRM_RESIDUAL_THRESH = {
    g: t['RESIDUAL_ABS_LIMIT'] for g, t in DOMAIN_THRESHOLDS.items()
}
DEFAULT_RESIDUAL_THRESH = DEFAULT_THRESH['RESIDUAL_ABS_LIMIT']


def _fetch_recent_values(device, gas_type: str, n: int = MIN_INPUT_LENGTH) -> list:
    """SensorData 에서 최근 n 개 측정값을 시간 오름차순으로 반환.

    None 값은 제외 (TTM 입력에 NaN 안 들어가게).
    """
    from devices.models import SensorData

    field = gas_type.lower()
    qs = (
        SensorData.objects
        .filter(device=device)
        .exclude(**{f'{field}__isnull': True})
        .order_by('-timestamp')
        .values_list(field, flat=True)[:n]
    )
    # 시간 오름차순 (오래된 → 최근)
    return list(reversed(list(qs)))


def _fallback_residual(device, gas_type: str) -> float:
    """TTM 입력 부족 시 단순 평균 차이 fallback (v2 동작).

    잔차 = 최근 5분 평균 − 직전 25분 평균.
    데이터 부족 시 0.0.
    """
    from devices.models import SensorData

    field = gas_type.lower()
    now = timezone.now()
    recent_start = now - timedelta(seconds=LOOKBACK_RECENT_SEC)
    baseline_start = now - timedelta(seconds=LOOKBACK_BASELINE_SEC)

    recent_avg = (
        SensorData.objects
        .filter(device=device, timestamp__gte=recent_start)
        .exclude(**{f'{field}__isnull': True})
        .aggregate(avg=Avg(field))
    )['avg']
    baseline_avg = (
        SensorData.objects
        .filter(
            device=device,
            timestamp__gte=baseline_start,
            timestamp__lt=recent_start,
        )
        .exclude(**{f'{field}__isnull': True})
        .aggregate(avg=Avg(field))
    )['avg']

    if recent_avg is None or baseline_avg is None:
        return 0.0
    return float(recent_avg - baseline_avg)


def get_recent_residual(device, gas_type: str) -> float:
    """센서의 최근 잔차.

    TTM 입력 충분하면 (>=608 건) 실제 TTM 추론, 부족하면 fallback.

    Returns:
        잔차 절대값 (양수). 호출 측 has_anomaly 가 abs() 한 번 더 적용해도 무영향.
    """
    values = _fetch_recent_values(device, gas_type, n=MIN_INPUT_LENGTH)

    if len(values) < MIN_INPUT_LENGTH:
        # 운영 초기 데이터 부족 — v2 fallback
        return _fallback_residual(device, gas_type)

    try:
        result = engine.predict(values, gas_type=gas_type)
    except Exception as e:
        # TTM 추론 실패 시도 fallback (안정성)
        print(f"[TTM] 추론 실패, fallback 사용: {e}")
        return _fallback_residual(device, gas_type)

    # 96 step 잔차 중 가장 큰 절대값 (이상 신호의 대표값)
    return result['residual_max_abs']


def has_anomaly(device, gas_type: str, threshold: float = None) -> bool:
    """센서 이상 패턴 여부.

    threshold 미지정 시 도메인별 RESIDUAL_ABS_LIMIT 사용.
    """
    if threshold is None:
        threshold = CONFIRM_RESIDUAL_THRESH.get(
            gas_type.lower(),
            DEFAULT_RESIDUAL_THRESH,
        )
    return abs(get_recent_residual(device, gas_type)) > threshold


# ─────────────────────────────────────────
# Phase L — TTM 사전 경고 (forecast_warn)
# ─────────────────────────────────────────

def get_forecast_warning(device, gas_type: str) -> dict:
    """TTM 96 step forecast 기반 사전 경고 신호.

    spike 가 이미 발생한 후 잔차로 판정하는 has_anomaly() 와 달리,
    이 함수는 미래 96 step (약 1.6시간) 의 예측에서 CAUTION 임계 초과를
    감지. 위험 발생 *이전* 사전 경고 트리거로 사용.

    Returns:
        {
            'warn':         bool,      # 사전 경고 발동 여부
            'exceed_count': int,       # forecast 96 중 CAUTION 초과 갯수
            'reason':       str,       # 'ok' | 'insufficient_data' | 'inference_failed'
        }
    """
    values = _fetch_recent_values(device, gas_type, n=MIN_INPUT_LENGTH)
    if len(values) < MIN_INPUT_LENGTH:
        return {
            'warn': False,
            'exceed_count': 0,
            'reason': 'insufficient_data',
        }

    try:
        result = engine.predict(values, gas_type=gas_type)
    except Exception as e:
        return {
            'warn': False,
            'exceed_count': 0,
            'reason': f'inference_failed: {e}',
        }

    return {
        'warn': bool(result['forecast_warn']),
        'exceed_count': int(result['forecast_exceed_count']),
        'reason': 'ok',
    }
